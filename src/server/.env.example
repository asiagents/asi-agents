# ASI server reads these at process start (copy to .env in repo root or export in shell).
# Ollama must be running on the same machine as the server unless you point elsewhere.

# Product API + built UI (default 3445). Open http://127.0.0.1:3445 after `npm run start`.
# ASI_SERVER_PORT=3445
# Bind address (default 127.0.0.1). Use 0.0.0.0 inside Docker so port publish works.
# ASI_SERVER_HOST=127.0.0.1
# Legacy alias still accepted:
# ASI_ENGINE_PORT=3445

# Virtual Desk daemon (separate process — do NOT use the product port).
# ASI_DESK_URL=http://127.0.0.1:3456
# ASI_DESK_REPO=D:\Agent Virtual Desk
# DESK_ROOT=D:\Agent Virtual Desk
# Local default ON — spawn python daemon/desk_daemon.py via POST /api/desk/start when /desk opens.
# ASI_DESK_AUTOSTART=1
# Cheap VPS / ship-safe: set ASI_DESK_AUTOSTART=0
# Optional python binary override:
# ASI_DESK_PYTHON=C:\Path\To\python.exe

# Default if unset: http://127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434

# Docker/WSL: use host.docker.internal or the Windows host IP — not 127.0.0.1 inside the container.
# OLLAMA_HOST=http://host.docker.internal:11434

# --- Inbox email (IMAP / Gmail) ---
# App password path (read + SMTP send):
# ASI_IMAP_HOST=imap.gmail.com
# ASI_IMAP_USER=you@gmail.com
# ASI_IMAP_PASS=your-app-password
# ASI_IMAP_PORT=993
# ASI_IMAP_SECURE=true
# ASI_IMAP_MAILBOX=INBOX
# ASI_IMAP_KIND=gmail
# Optional SMTP overrides: ASI_SMTP_HOST, ASI_SMTP_PORT, ASI_SMTP_SECURE
# POP3 is not supported yet — use IMAP.

# Gmail OAuth (read via IMAP XOAUTH2). Or save client id/secret in Settings → Connections → Configure.
# Register this redirect on the Google OAuth client:
#   http://localhost:3445/api/inbox/email/oauth/callback
# ASI_GMAIL_CLIENT_ID=
# ASI_GMAIL_CLIENT_SECRET=
# ASI_GMAIL_REDIRECT_URI=http://localhost:3445/api/inbox/email/oauth/callback
# Note: OAuth send may return 501 — use app-password IMAP/SMTP for replies.
# Drive is NOT included in Gmail scopes — use Google Drive Connect separately.

# --- Google Calendar (today's primary calendar only) ---
# Register redirect:
#   http://127.0.0.1:3445/api/calendar/oauth/google/callback
# ASI_GOOGLE_CALENDAR_CLIENT_ID=
# ASI_GOOGLE_CALENDAR_CLIENT_SECRET=
# ASI_GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3445/api/calendar/oauth/google/callback

# --- Google Drive (optional; drive.readonly only) ---
#   http://127.0.0.1:3445/api/drive/oauth/google/callback
# ASI_GOOGLE_DRIVE_CLIENT_ID=   # falls back to ASI_GMAIL_CLIENT_ID if unset
# ASI_GOOGLE_DRIVE_CLIENT_SECRET=
# ASI_GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:3445/api/drive/oauth/google/callback

# --- Microsoft Graph (calendar + Mail.Read) ---
#   http://127.0.0.1:3445/api/calendar/oauth/microsoft/callback
# ASI_MICROSOFT_CLIENT_ID=
# ASI_MICROSOFT_CLIENT_SECRET=
# ASI_MICROSOFT_REDIRECT_URI=http://127.0.0.1:3445/api/calendar/oauth/microsoft/callback
# Aliases: ASI_MICROSOFT_CALENDAR_CLIENT_ID / SECRET still accepted.

# Post-OAuth UI return (dev Vite default shown):
# ASI_UI_ORIGIN=http://127.0.0.1:5173

# --- Squari Companion (UI module) ---
# Prod / remote: companion OFF until Settings → Modules → Show Squari.
# Test bed / local iterate: defaults ON when localStorage unset if hostname is
# localhost/127.0.0.1, or Vite DEV, or bake VITE_ASI_COMPANION_TEST=1 into the UI build.
# ASI_COMPANION_TEST=1
# VITE_ASI_COMPANION_TEST=1
